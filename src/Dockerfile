# Используем официальный образ Java 17
FROM openjdk:17

# Устанавливаем рабочую директорию внутри контейнера
WORKDIR /app

# Копируем все исходники из папки src в контейнер
COPY src/ /app/

# Компилируем все .java файлы
RUN javac *.java

# Устанавливаем команду по умолчанию для запуска приложения
CMD ["java", "Main"]